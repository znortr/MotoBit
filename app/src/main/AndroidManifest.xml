<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Basic networking -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Wi-Fi Direct: usato dalla modalita' link "P2P" -->
    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <!--
        Tipo `location` del foreground service: NON serve alla posizione.
        Serve a far considerare l'app "in foreground" per le API Wi-Fi Direct
        (WifiP2pManager e' location-gated da Android 10): senza, con l'app in
        background discoverPeers()/connect() falliscono con ERROR e il TFT non
        viene piu' ritrovato dopo uno spegnimento.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Feedback aptico su connessione/perdita del link (opzionale) -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Usato solo dal dialog di sistema per escludere l'app dal Doze -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MotobitRide">
        <service
            android:name="com.nos.motobitride.core.hud.ScreenCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|location" />

        <!-- Azioni della notifica di mirroring (Stop / Riconnetti) -->
        <receiver
            android:name="com.nos.motobitride.core.hud.NotificationActionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nos.motobitride.action.STOP" />
                <action android:name="com.nos.motobitride.action.RECONNECT" />
            </intent-filter>
        </receiver>

        <!-- Azioni della notifica di scadenza (Posponi / Elimina) -->
        <receiver
            android:name="com.nos.motobitride.core.garage.DeadlineActionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nos.motobitride.action.DEADLINE_SNOOZE" />
                <action android:name="com.nos.motobitride.action.DEADLINE_DISMISS" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MotobitRide">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
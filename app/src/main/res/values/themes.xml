<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MotobitRide" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        Tema della sola schermata di avvio: finestra con lo splash scuro al posto
